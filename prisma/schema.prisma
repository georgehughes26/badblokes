// Bad Blokes Acca — data model
// See lib/rules.ts for the pure scoring/fines engine that consumes this data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  email        String? // optional, for future reminder notifications (out of scope for v1)
  role         Role     @default(PLAYER)
  avatarUrl    String?
  active       Boolean  @default(true)
  joinedAt     DateTime @default(now())

  sessions                  Session[]
  picks                     Pick[]
  results                   Result[]
  fineEntries               FineLedgerEntry[]          @relation("FineOwner")
  recordedFines             FineLedgerEntry[]          @relation("FineRecorder")
  createdInvites            InviteCode[]               @relation("InviteCreator")
  auditLogs                 AuditLog[]
  verifiedSlips             BetSlip[]                  @relation("SlipVerifier")
  pointsAdjustments         PointsAdjustment[]
  noPickSlips               NoPickSlip[]
  historicStandings         HistoricStanding[]
  historicPointsAdjustments HistoricPointsAdjustment[]
  gotmStakePayments         GotmStakePayment[]         @relation("GotmStakeOwner")
  recordedGotmStakes        GotmStakePayment[]         @relation("GotmStakeRecorder")
  recordedGotmPayouts       GotmBatchPayout[]          @relation("GotmPayoutRecorder")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A shared invite code the group hands out on WhatsApp. Not single-use by
// default (maxUses null = unlimited) so one code can onboard the whole group.
model InviteCode {
  code        String    @id
  role        Role      @default(PLAYER)
  maxUses     Int? // null = unlimited
  useCount    Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id])
}

// ---------------------------------------------------------------------------
// Competition structure
// ---------------------------------------------------------------------------

model Season {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  active         Boolean  @default(false)
  // The Christmas-Day-style boundary that splits the season into two joker
  // halves: one joker usable before this date, one usable on/after it.
  jokerSplitDate DateTime
  createdAt      DateTime @default(now())

  gameweeks         Gameweek[]
  pointsAdjustments PointsAdjustment[]
  gotmStakePayments GotmStakePayment[]
  gotmBatchPayouts  GotmBatchPayout[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Note on architecture: there is deliberately no Fixture model. A pick only
// ever needs "did the team this player picked win, or go 2 up?" — never the
// opponent or the scoreline — so admin enters that one fact directly against
// each Pick once games are done (see Pick.resultWon / resultWentTwoUp below).
// ---------------------------------------------------------------------------

enum GameweekStatus {
  UPCOMING
  OPEN
  LOCKED
  SETTLED
}

model Gameweek {
  id             String         @id @default(cuid())
  seasonId       String
  season         Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  weekNumber     Int
  picksOpenAt    DateTime // Day before kick-off, 12:00 Europe/London (stored UTC)
  pickDeadlineAt DateTime // Day before kick-off, 23:59 Europe/London
  slipDeadlineAt DateTime // Kick-off day, 15:00 Europe/London
  status         GameweekStatus @default(UPCOMING)
  settledAt      DateTime?
  createdAt      DateTime       @default(now())

  picks       Pick[]
  results     Result[]
  fineEntries FineLedgerEntry[]
  noPickSlips NoPickSlip[]

  @@unique([seasonId, weekNumber])
  @@index([status])
}

model Team {
  id        String  @id @default(cuid())
  name      String  @unique
  shortName String
  crestUrl  String?
  division  String? // e.g. "Premier League", "Championship" — null for manually-added teams
  active    Boolean @default(true)

  picks Pick[]

  @@index([division])
}

// ---------------------------------------------------------------------------
// Picks & slips
// ---------------------------------------------------------------------------

model Pick {
  id                String   @id @default(cuid())
  gameweekId        String
  gameweek          Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id])
  isJoker           Boolean  @default(false)
  createdAt         DateTime @default(now()) // server timestamp — decides first-come-first-served
  overriddenByAdmin Boolean  @default(false)
  overrideReason    String?

  // Admin-entered once games are done. Null until results are in. Combined
  // (either true = "won" for the rules engine) — kept separate so the UI can
  // still label an EP win as "Won (EP)" distinctly from an outright win.
  // resultShortOdds is likewise a manual admin call (players no longer type
  // odds into the app — that's worked out among themselves) rather than
  // derived from a stored odds value.
  resultWon       Boolean?
  resultWentTwoUp Boolean?
  resultShortOdds Boolean?
  resultEnteredAt DateTime?

  betSlip BetSlip?

  // DB-level guarantees: one pick per player per gameweek, and one pick per
  // team per gameweek (first come, first served — enforced by the DB, not
  // just app logic, so simultaneous submits can't both win).
  @@unique([gameweekId, userId])
  @@unique([gameweekId, teamId])
  @@index([userId])
}

model BetSlip {
  id              String    @id @default(cuid())
  pickId          String    @unique
  pick            Pick      @relation(fields: [pickId], references: [id], onDelete: Cascade)
  token           String    @unique // unguessable token used in /slip/:token
  storagePath     String? // local disk / S3 key for uploaded image
  externalUrl     String? // pasted bookmaker share link, alternative to upload
  mimeType        String?
  submittedAt     DateTime?
  verifiedByAdmin Boolean   @default(false)
  verifiedById    String?
  verifiedBy      User?     @relation("SlipVerifier", fields: [verifiedById], references: [id])
  createdAt       DateTime  @default(now())
}

// A slip-link submission for a player who didn't log a pick in the app at
// all (so there's no Pick row to hang a BetSlip off of) — lets them prove
// they still placed a real bet, which softens the no-pick fine from £10
// and -1 down to £5 and 0 (see rules.ts — same breach-A/breach-B logic
// that already applies to a picked player who misses the slip deadline).
model NoPickSlip {
  id          String    @id @default(cuid())
  gameweekId  String
  gameweek    Gameweek  @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  externalUrl String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([gameweekId, userId])
}

// ---------------------------------------------------------------------------
// Settlement & fines
// ---------------------------------------------------------------------------

model Result {
  id                 String   @id @default(cuid())
  gameweekId         String
  gameweek           Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points             Int
  breachNoPick       Boolean  @default(false) // A
  breachNoSlip       Boolean  @default(false) // B
  breachShortOdds    Boolean  @default(false) // C
  breachTeamLost     Boolean  @default(false) // D
  breachJokerLost    Boolean  @default(false) // E
  fineAmount         Int      @default(0)
  fineRuleId         String // which rule in the precedence list fired
  fineReason         String // human readable, e.g. "£10 — joker lost"
  jokerPlayed        Boolean  @default(false)
  computedAt         DateTime @default(now())
  manuallyOverridden Boolean  @default(false)
  overrideReason     String?

  @@unique([gameweekId, userId])
  @@index([userId])
}

model FineLedgerEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("FineOwner", fields: [userId], references: [id], onDelete: Cascade)
  gameweekId   String
  gameweek     Gameweek  @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String
  paid         Boolean   @default(false)
  paidAt       DateTime?
  recordedById String?
  recordedBy   User?     @relation("FineRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([gameweekId, userId])
  @@index([userId])
  @@index([paid])
}

// A manual points adjustment applied to a player's season total, outside the
// normal per-gameweek Result flow — e.g. a carried-over penalty from
// something unrelated to picks. Deliberately has no fine/gameweek attached;
// use FineLedgerEntry for anything that should also hit the pot.
model PointsAdjustment {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([seasonId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Gambler of the Month money — settled per 4-gameweek batch (see
// lib/standings.ts GOTM_BATCH_SIZE). Two things move each batch:
//   1. A flat GOTM_STAKE (£10) each player pays IN before the batch starts
//      (batch N's stake is due by GW ((N-1)*4 + 1)'s pick deadline). The
//      whole pot goes to that batch's winner once it's done.
//   2. That batch's accumulated fines, due by the NEXT batch's first
//      gameweek's pick deadline — the fines themselves double if late (the
//      stake never does). Fine payment is tracked on FineLedgerEntry.paid,
//      not here.
// ---------------------------------------------------------------------------

model GotmStakePayment {
  id           String    @id @default(cuid())
  seasonId     String
  season       Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  batchNumber  Int
  userId       String
  user         User      @relation("GotmStakeOwner", fields: [userId], references: [id], onDelete: Cascade)
  paid         Boolean   @default(false)
  paidAt       DateTime?
  recordedById String?
  recordedBy   User?     @relation("GotmStakeRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([seasonId, batchNumber, userId])
  @@index([userId])
  @@index([seasonId, batchNumber])
}

// One row = "this batch's pot has been settled". Absence = not settled yet.
// rolledToPot distinguishes how: false = paid to the batch winner(s);
// true = the batch was a tie so the whole GOTM pot was tipped into the
// fines pot instead (added to the fines Total pot — see lib/batch-settlement.ts).
model GotmBatchPayout {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  batchNumber  Int
  paidOutAt    DateTime @default(now())
  rolledToPot  Boolean  @default(false)
  recordedById String?
  recordedBy   User?    @relation("GotmPayoutRecorder", fields: [recordedById], references: [id])

  @@unique([seasonId, batchNumber])
}

// ---------------------------------------------------------------------------
// Pre-app history — seasons played (on paper/WhatsApp) before this app
// existed. Only final per-player P/W/L survives from back then, not
// gameweek-by-gameweek picks, so these are hand-entered season totals
// rather than rows derived from Gameweek/Pick/Result like everything else.
// Feeds the All Time Table and the all-time half of a player's profile —
// see lib/all-time.ts. Deliberately carries no points/fines/joker columns:
// the current app's Result.points and this era's win counts aren't the
// same unit (see HistoricStanding.won), so All Time only ever compares P/W/L.
// ---------------------------------------------------------------------------

model HistoricSeason {
  id        String             @id @default(cuid())
  label     String             @unique // e.g. "2024/25"
  // Chronological order for display — oldest first — since the label
  // string alone doesn't sort correctly forever (e.g. once seasons cross
  // a decade boundary).
  order     Int
  standings HistoricStanding[]
}

model HistoricStanding {
  id               String         @id @default(cuid())
  historicSeasonId String
  historicSeason   HistoricSeason @relation(fields: [historicSeasonId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  played           Int
  // Recorded using that era's scoring convention (a joker win counted as 2
  // wins and a loss un-done, not a separate points value) — treat `won` as
  // that season's ranking score, not a literal count of gameweeks won.
  won              Int
  lost             Int

  @@unique([historicSeasonId, userId])
  @@index([userId])
}

// A career-wide points penalty/bonus from before the app existed — e.g. a
// "First To Leave <year>" forfeit — that doesn't belong to one specific
// historic season. Mirrors PointsAdjustment, but adjusts a player's overall
// All Time points total only, never their P/W/L (those stay the real
// per-season record) and never a specific in-app Season's total.
model HistoricPointsAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Settings & audit
// ---------------------------------------------------------------------------

model Setting {
  key         String   @id
  value       String // JSON-encoded
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     String? // JSON-encoded
  after      String? // JSON-encoded
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
