# Postgres. If using Supabase: DATABASE_URL is the pooled ("Transaction
# pooler", port 6543) connection string used by the app at runtime; DIRECT_URL
# is the direct/session connection (port 5432) Prisma uses to run migrations.
# If using docker-compose or a plain local Postgres, both can point at the
# same database.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Optional: your own free key from https://www.thesportsdb.com/free_sports_api
# — used only to pre-populate team lists/fixtures/scores. Falls back to the
# shared "123" test key if unset.
SPORTSDB_API_KEY=
